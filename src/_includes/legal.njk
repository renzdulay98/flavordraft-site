---
layout: base.njk
---
{%- set doc = legal[legalDoc] -%}
<div class="wrap legal-head">
  <p class="overline">{{ legalKicker }}</p>
  <h1 class="legal-head__title">{{ doc.title }}</h1>

  {%- if doc.effectiveDate %}
  <dl class="legal-head__meta">
    <div><dt>Effective date</dt> <dd>{{ doc.effectiveDate }}</dd></div>
  </dl>
  {%- endif %}
</div>

<div class="wrap legal-body">
  <div class="legal-body__grid">
    <nav class="toc" aria-labelledby="toc-title" data-toc>
      <p class="overline toc__title" id="toc-title">Contents</p>
      <div class="toc__list">
        {%- for heading in content | headings %}
        <a href="#{{ heading.id }}"><span class="toc__num">{{ heading.number }}</span> {{ heading.label }}</a>
        {%- endfor %}
      </div>
    </nav>

    <div class="legal-prose">
      {{ content | safe }}
    </div>
  </div>
</div>
