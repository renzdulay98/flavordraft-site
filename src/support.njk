      <div class="contact">
        <p class="contact__label">FlavorDraft Support</p>
        <a class="contact__email" href="mailto:{{ email }}">{{ email }}</a>
        <p class="contact__actions"><a class="button" href="mailto:{{ email }}?subject=FlavorDraft%20support">Email FlavorDraft Support</a></p>
      </div>
      <p class="notice">Please don't include passwords or payment information in your email.</p>
    </div>

    <div class="checklist">
      <p class="checklist__title">Helpful to include</p>
      <ul>
        <li>What you were trying to do</li>
        <li>What happened instead</li>
        <li>A screenshot of the issue</li>
        <li>Your iPhone model</li>
        <li>Your iOS version</li>
        <li>Your FlavorDraft app version</li>
      </ul>
    </div>
  </div>
</section>
