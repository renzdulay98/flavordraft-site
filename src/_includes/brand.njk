{# ---------------------------------------------------------------------------
   Brand pieces shared by every page. Import with context where noted, so the
   macros can read the site's data:  {% from "brand.njk" import img with context %}

   wordmark()      The approved FlavorDraft wordmark, the same raster the app
                   ships (see wordmark_handoff/README.md): logoRed #9E1F1F on
                   transparent, resampled by `npm run icons` to 1×, 2× and 3×
                   of the widths the header and footer draw it at. Sized by
                   width only; the 4.354:1 aspect follows.
   appStoreCta()   The download call to action: Apple's own "Download on the
                   App Store" badge, linking to site.appStoreUrl. The artwork
                   is Apple's, used unaltered (see README). One per screen: the
                   header says "Download" in words instead.
   img()           (with context) A responsive image from src/assets/img/screens/,
                   built by `npm run screens` from scripts/screens.json: AVIF
                   first, WebP otherwise, at the size src/_data/screens.json
                   records, so no template states an image's dimensions.
   ink()           (with context) A mark of the red pen, from src/_data/pen.js.
                   Decorative and always aria-hidden; home.css draws it on.
   --------------------------------------------------------------------------- #}

{% macro wordmark(size) %}
{%- set file = "/assets/img/wordmark-flavordraft" -%}
<img class="wordmark__img{% if size %} wordmark__img--{{ size }}{% endif %}" src="{{ file }}-280.png" srcset="{{ file }}-140.png 140w, {{ file }}-280.png 280w, {{ file }}-420.png 420w, {{ file }}-560.png 560w" sizes="{{ '152px' if size == 'footer' else '140px' }}" alt="FlavorDraft" width="1193" height="274"{% if size == 'footer' %} loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{% macro appStoreCta(site) %}
<a class="appstore" href="{{ site.appStoreUrl }}"><img class="appstore__badge" src="/assets/img/app-store-badge.svg" alt="Download on the App Store" width="120" height="40" decoding="async"></a>
{%- endmacro %}

{#
  img(name, alt, sizes, options)
    options.class     class on the <img>
    options.priority  true for the image that paints first: loads eagerly at high priority
    options.eager     true for other images in the first screen: loads eagerly
    options.media     [[mediaQuery, otherName], …] art direction: another image for a viewport
    options.hidden    true for a picture that starts out of sight (home.js shows it): hidden
                      from assistive tech until then
#}
{% macro img(name, alt, sizes, options) %}
{%- set o = options or {} -%}
{%- set s = screens[name] -%}
{%- set base = "/assets/img/screens/" -%}
<picture>
{%- for pair in o.media or [] %}{% set m = screens[pair[1]] %}
<source media="{{ pair[0] }}" type="image/avif" srcset="{% for w in m.widths %}{{ base }}{{ pair[1] }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}" width="{{ m.w }}" height="{{ m.h }}">
<source media="{{ pair[0] }}" type="image/webp" srcset="{% for w in m.widths %}{{ base }}{{ pair[1] }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}" width="{{ m.w }}" height="{{ m.h }}">
{%- endfor %}
<source type="image/avif" srcset="{% for w in s.widths %}{{ base }}{{ name }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
<img{% if o.class %} class="{{ o.class }}"{% endif %} src="{{ base }}{{ name }}-{{ s.widths[(s.widths | length) // 2] }}.webp" srcset="{% for w in s.widths %}{{ base }}{{ name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}" width="{{ s.w }}" height="{{ s.h }}" alt="{{ alt }}"{% if o.hidden %} aria-hidden="true"{% endif %}{% if o.priority %} loading="eager" fetchpriority="high"{% elif o.eager %} loading="eager"{% else %} loading="lazy"{% endif %} decoding="async">
</picture>
{%- endmacro %}

{#
  ink(name, class)
  The finished stroke is a filled shape; a mask strokes the centre line over it,
  and home.css draws that mask on along its length (pathLength 1), so the mark
  arrives the way the pen made it. Mask ids are unique per mark name, so each
  mark appears once per page.
#}
{% macro ink(name, class) %}
{%- set m = pen[name] -%}
<svg class="ink ink--{{ name }}{% if class %} {{ class }}{% endif %}" viewBox="{{ m.viewBox }}" preserveAspectRatio="{{ 'none' if name == 'underline' else 'xMidYMid meet' }}" aria-hidden="true" focusable="false">
{%- for stroke in m.strokes %}
<mask id="ink-{{ name }}-{{ loop.index }}" maskUnits="userSpaceOnUse" x="{{ m.maskBox[0] }}" y="{{ m.maskBox[1] }}" width="{{ m.maskBox[2] }}" height="{{ m.maskBox[3] }}"><path class="ink__reveal" d="{{ stroke.line }}" pathLength="1" stroke-width="{{ stroke.reveal }}"/></mask>
<path class="ink__stroke" d="{{ stroke.shape }}" mask="url(#ink-{{ name }}-{{ loop.index }})"/>
{%- endfor %}
</svg>
{%- endmacro %}
