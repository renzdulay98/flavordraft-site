{%- from "brand.njk" import wordmark -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.url }}{{ canonical }}">

<meta name="theme-color" content="{{ site.themeColor }}">
<meta name="color-scheme" content="light">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ canonical }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="FlavorDraft — Every recipe you love. One cookbook.">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/appicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

{% if heroImage -%}
<link rel="preload" as="image" href="/assets/img/screens/{{ heroImage }}-800.webp" imagesrcset="/assets/img/screens/{{ heroImage }}-400.webp 400w, /assets/img/screens/{{ heroImage }}-800.webp 800w, /assets/img/screens/{{ heroImage }}-1200.webp 1200w" imagesizes="(min-width: 62em) 26rem, 72vw">
{% endif -%}
<link rel="stylesheet" href="/assets/css/site.css">
<script>document.documentElement.classList.add("js");</script>
<script src="/assets/js/site.js" defer></script>
</head>
<body class="page{% if pageClass %} page--{{ pageClass }}{% endif %}">

<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead" id="masthead">
  <div class="wrap masthead__inner">
    <a class="wordmark" href="/">{{ wordmark() }}</a>

    <button class="masthead__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="masthead__toggle-bars" aria-hidden="true"><i></i><i></i></span>
      <span class="masthead__toggle-label">Menu</span>
    </button>

    <nav class="masthead__nav" id="site-nav" aria-label="Site">
      <a class="masthead__link" href="/#features">Features</a>
      <a class="masthead__link" href="/support"{% if canonical == "/support" %} aria-current="page"{% endif %}>Support</a>
      {% if site.appStoreUrl -%}
        <a class="masthead__cta" href="{{ site.appStoreUrl }}">Download</a>
      {%- else -%}
        <span class="masthead__status"><span class="coming__dot" aria-hidden="true"></span>iPhone · coming&nbsp;soon</span>
      {%- endif %}
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="colophon">
  <div class="wrap">
    <div class="colophon__grid">
      <div class="colophon__brand">
        {{ wordmark("wordmark__lockup--footer") }}
        <p class="colophon__tagline">{{ site.tagline }}</p>
      </div>

      <nav class="colophon__nav" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        {% if site.appStoreUrl %}<a href="{{ site.appStoreUrl }}">App Store</a>{% endif %}
        <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
      </nav>
    </div>

    <p class="colophon__legal">© {{ site.legal.copyrightYear }}{% if build.year > (site.legal.copyrightYear | int) %}–{{ build.year }}{% endif %} FlavorDraft. All rights reserved.</p>
  </div>
</footer>

</body>
</html>
