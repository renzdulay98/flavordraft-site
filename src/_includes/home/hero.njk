{%- from "brand.njk" import appStoreCta, img, ink with context -%}
{#
  The 2.0 announcement. The words arrive from the left in three quiet steps
  (home.css), then the pen rings "2.0" and underlines "iPhone Duo"; the words
  themselves are plain type. Beside them, the App Store campaign's own hardware
  with FlavorDraft's real screens on it (scripts/screens.json): the iPhone Duo
  lying open with a recipe across its two pages like a cookbook, and the dark
  iPhone with the same cookbook's Home, resting over the Duo's corner. On phones
  the words come first and the devices follow.
#}
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__news"><span class="hero__arrive hero__arrive--1">FlavorDraft</span> <span class="nowrap"><span class="hero__arrive hero__arrive--1 inked inked--ring">2.0{{ ink("ring") }}</span> <span class="hero__arrive hero__arrive--2">is here.</span></span></span>
        <span class="hero__made hero__arrive hero__arrive--3">Made for <span class="inked inked--under">iPhone Duo{{ ink("underline") }}</span>.</span>
      </h1>
      <p class="hero__lead">Save recipes from videos, websites, photos and more, then keep them together in one personal cookbook, on iPhone and <span class="nowrap">iPhone Duo</span>.</p>
      <div class="hero__actions">
        {{ appStoreCta(site) }}
        <a class="hero__more" href="#iphone-duo">See what’s new</a>
      </div>
    </div>

    <figure class="hero__stage">
      <div class="hero__scene">
      <div class="hero__duo">
        {{ img("hero-duo", "FlavorDraft on iPhone Duo, lying open: Chicken Parmesan across the two pages like a cookbook, its method in numbered steps on the left page and its ingredients on the right.", preloadSizes, { priority: true }) }}
      </div>
      <div class="hero__iphone">
        {{ img("hero-iphone", "FlavorDraft on iPhone: Home, with “Good morning, Stan. What are you cooking today?” above the Recently Saved Tiramisu and, under Quick Access, the Weeknight Dinners and Desserts collections.", "(min-width: 90rem) 200px, (min-width: 80em) 14vw, (min-width: 75em) 13vw, (min-width: 62em) and (orientation: landscape) 13vw, (min-width: 40em) and (orientation: landscape) 11vw, 26vw", { eager: true }) }}
      </div>
      </div>
      <figcaption class="caption hero__caption">On <span class="nowrap">iPhone Duo</span>, a recipe opens across two pages. The same cookbook, on iPhone.</figcaption>
    </figure>
  </div>
</section>
