{# The support address is deliberately not invented. While site.contactEmail is
   null every page that needs it renders a visible [CONTACT_EMAIL] placeholder,
   and the build prints a warning naming it. #}
{% macro contact(site) %}
{%- if site.contactEmail -%}
<a class="legal-contact" href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
{%- else -%}
<span class="legal-contact">[CONTACT_EMAIL]</span>
{%- endif -%}
{% endmacro %}
