{%- from "brand.njk" import wordmark -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ tabTitle or pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.url }}{{ canonical }}">

<meta name="theme-color" content="{{ site.themeColor }}">
<meta name="color-scheme" content="light">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ canonical }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/img/og.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt or site.ogImageAlt }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

{% if preloadImage -%}
{%- set p = screens[preloadImage] -%}
<link rel="preload" as="image" type="image/avif" imagesrcset="{% for w in p.widths %}/assets/img/screens/{{ preloadImage }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" imagesizes="{{ preloadSizes }}" fetchpriority="high">
{% endif -%}
<link rel="stylesheet" href="/assets/css/site.css">
{% if pageStyles %}<link rel="stylesheet" href="/assets/css/{{ pageStyles }}.css">
{% endif -%}
<script>document.documentElement.classList.add("js");</script>
<script src="/assets/js/site.js" defer></script>
{% if pageScript %}<script src="/assets/js/{{ pageScript }}.js" defer></script>
{% endif -%}
{% if structuredData -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": {{ (site.url + "/#website") | dump | safe }},
      "url": {{ (site.url + "/") | dump | safe }},
      "name": {{ site.name | dump | safe }}
    },
    {
      "@type": "MobileApplication",
      "@id": {{ (site.url + "/#app") | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "operatingSystem": "iOS",
      "applicationCategory": "LifestyleApplication",
      "url": {{ (site.url + "/") | dump | safe }},
      "downloadUrl": {{ site.appStoreUrl | dump | safe }},
      "installUrl": {{ site.appStoreUrl | dump | safe }},
      "image": {{ (site.url + "/assets/img/og.png") | dump | safe }}
    }
  ]
}
</script>
{% endif -%}
</head>
<body class="page{% if pageClass %} page--{{ pageClass }}{% endif %}">

<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead" id="masthead">
  <div class="wrap masthead__inner">
    <a class="wordmark" href="/">{{ wordmark() }}</a>

    <button class="masthead__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="masthead__toggle-bars" aria-hidden="true"><i></i><i></i></span>
      <span class="masthead__toggle-label">Menu</span>
    </button>

    <nav class="masthead__nav" id="site-nav" aria-label="Site">
      <a class="masthead__link" href="/#features">Features</a>
      <a class="masthead__link" href="/#iphone-duo">What’s new</a>
      <a class="masthead__link" href="/support/"{% if canonical == "/support/" %} aria-current="page"{% endif %}>Support</a>
      <a class="masthead__cta" href="{{ site.appStoreUrl }}">Download<span class="masthead__cta-more"> on the App Store</span></a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="colophon">
  <div class="wrap">
    <div class="colophon__grid">
      <div class="colophon__brand">
        {{ wordmark("footer") }}
        <p class="colophon__tagline">{{ site.tagline | escape | replace("iPhone Duo", '<span class="nowrap">iPhone Duo</span>') | safe }}</p>
      </div>

      <nav class="colophon__nav" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/support/">Support</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="{{ site.appStoreUrl }}">App Store</a>
        <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
      </nav>
    </div>

    <div class="colophon__legal">
      <p>© {{ site.legal.copyrightYear }}{% if build.year > (site.legal.copyrightYear | int) %}–{{ build.year }}{% endif %} FlavorDraft. All rights reserved.</p>
      <p>{{ site.legal.appleCredit | escape | replace("iPhone Duo", '<span class="nowrap">iPhone Duo</span>') | replace("App Store", '<span class="nowrap">App Store</span>') | safe }}</p>
    </div>
  </div>
</footer>

</body>
</html>
