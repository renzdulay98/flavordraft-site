{%- from "brand.njk" import appStoreCta, img, ink with context -%}
{#
  The 2.0 announcement. The words arrive from the left in three quiet steps
  (home.css), then the pen rings "2.0" and underlines "iPhone Duo"; the words
  themselves are plain type. Beside them, the family: the App Store campaign's
  own hardware with FlavorDraft's real screens on it (scripts/screens.json),
  each seen from where it reads true, as the campaign's frames see their phones
  (frame 01's camera for the phone lying open, the level camera for the one
  lying closed, a little lower for the tent). The iPhone Duo lying open with a
  recipe across its two pages like a cookbook is the anchor;
  the dark iPhone with Home rests in front over its corner; the Duo stood like a
  tent in Cook View stands in front along the Duo's foot, centre right; and the
  Duo closed, with My Recipes on its outer display, lies at the lower right. One
  cluster at one scale, no caption: the devices say it. On phones the words come
  first and only the open Duo and the iPhone follow.
#}
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__news"><span class="hero__arrive hero__arrive--1">FlavorDraft</span> <span class="nowrap"><span class="hero__arrive hero__arrive--1 inked inked--ring">2.0{{ ink("ring") }}</span> <span class="hero__arrive hero__arrive--2">is here.</span></span></span>
        <span class="hero__made hero__arrive hero__arrive--3">Made for <span class="inked inked--under">iPhone Duo{{ ink("underline") }}</span>.</span>
      </h1>
      <p class="hero__lead">Save recipes from videos, websites, photos and more, then keep them together in one personal cookbook, on iPhone and <span class="nowrap">iPhone Duo</span>.</p>
      <div class="hero__actions">
        {{ appStoreCta(site) }}
        <a class="hero__more" href="#iphone-duo">See what’s new</a>
      </div>
    </div>

    <div class="hero__stage">
      <div class="hero__scene">
        <div class="hero__device hero__device--duo">
          {{ img("hero-duo", "FlavorDraft on iPhone Duo, lying open: Chicken Parmesan across the two pages like a cookbook, its method in numbered steps on the left page and its ingredients on the right.", preloadSizes, { priority: true }) }}
        </div>
        <div class="hero__device hero__device--tent">
          {{ img("hero-tent", "iPhone Duo stood like a tent, Cook View on its outer display: “Bake for 25 minutes or until golden and bubbling”, with Previous, the step’s timer running and Next.", "(min-width: 90rem) 248px, (min-width: 80em) 19vw, (min-width: 75em) 17vw, (min-width: 62em) and (orientation: landscape) 16vw, 29vw") }}
        </div>
        <div class="hero__device hero__device--iphone">
          {{ img("hero-iphone", "FlavorDraft on iPhone: Home, with “Good morning, Stan. What are you cooking today?” above the Recently Saved Tiramisu and, under Quick Access, the Weeknight Dinners and Desserts collections.", "(min-width: 90rem) 224px, (min-width: 80em) 16vw, (min-width: 75em) 15vw, (min-width: 62em) and (orientation: landscape) 15vw, (min-width: 40em) and (orientation: landscape) 14vw, 30vw", { eager: true }) }}
        </div>
        <div class="hero__device hero__device--folded">
          {{ img("hero-folded", "iPhone Duo closed, My Recipes on its outer display: Chicken Parmesan, Lasagna, Carbonara and Tiramisu as index cards, two to a row.", "(min-width: 90rem) 186px, (min-width: 80em) 14vw, (min-width: 75em) 13vw, (min-width: 62em) and (orientation: landscape) 13vw, (min-width: 40em) and (orientation: landscape) 12vw, 22vw") }}
        </div>
      </div>
    </div>
  </div>
</section>
