{# ---------------------------------------------------------------------------
   Icons.

   The app draws its glyphs from Phosphor. Rather than load three Phosphor
   webfonts for eleven glyphs, these are inline at Phosphor's regular weight
   (256 box, 16 stroke, round caps and joins) so they sit at the same optical
   weight as the app's.

   Every icon here reproduces one that appears in real FlavorDraft UI. There
   are no decorative icons on this site.
   --------------------------------------------------------------------------- #}

{% macro icon(name, size) %}
{%- set s = size or 20 -%}
<svg viewBox="0 0 256 256" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "globe" -%}
  <circle cx="128" cy="128" r="96"/><path d="M37 96h182M37 160h182"/><path d="M128 32c-27 30-40 63-40 96s13 66 40 96c27-30 40-63 40-96s-13-66-40-96Z"/>
{%- elif name == "clock" -%}
  <circle cx="128" cy="128" r="96"/><path d="M128 72v56l42 25"/>
{%- elif name == "bowl" -%}
  <path d="M24 116h208a104 104 0 0 1-208 0Z"/><path d="M96 116c-12-20-4-40 8-52"/><path d="M148 116c-12-20-4-40 8-52"/>
{%- elif name == "gauge" -%}
  <path d="M40 176a100 100 0 1 1 176 0"/><path d="M128 176 180 106"/>
{%- elif name == "arrow-left" -%}
  <path d="M216 128H48M112 64l-64 64 64 64"/>
{%- elif name == "arrow-right" -%}
  <path d="M40 128h176M152 64l64 64-64 64"/>
{%- elif name == "heart" -%}
  <path d="M128 220S20 160 20 92a56 56 0 0 1 108-28 56 56 0 0 1 108 28c0 68-108 128-108 128Z"/>
{%- elif name == "dots" -%}
  <g fill="currentColor" stroke="none"><circle cx="60" cy="128" r="13"/><circle cx="128" cy="128" r="13"/><circle cx="196" cy="128" r="13"/></g>
{%- elif name == "circle" -%}
  <circle cx="128" cy="128" r="88"/>
{%- elif name == "check-circle" -%}
  <circle cx="128" cy="128" r="96" fill="currentColor" stroke="none"/><path d="m84 130 30 30 60-64" stroke="var(--knockout, #fffbf3)" stroke-width="18"/>
{%- elif name == "warning-circle" -%}
  <circle cx="128" cy="128" r="96" fill="currentColor" stroke="none"/><path d="M128 76v60" stroke="var(--knockout, #fffbf3)" stroke-width="18"/><circle cx="128" cy="172" r="11" fill="var(--knockout, #fffbf3)" stroke="none"/>
{%- endif -%}
</svg>
{% endmacro %}
