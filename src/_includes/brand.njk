{# ---------------------------------------------------------------------------
   Brand pieces shared by every page.

   wordmark()      The approved FlavorDraft wordmark, the same raster the app
                   ships (see wordmark_handoff/README.md): logoRed #9E1F1F on
                   transparent, or the parchment "mono" file when onRed is set.
                   Sized by width only; the 4.354:1 aspect follows.
   appStoreCta()   The download call to action: Apple's own "Download on the
                   App Store" badge, linking to site.appStoreUrl. The artwork
                   is Apple's, used unaltered (see README) — the black badge on
                   paper, the white one on red, "compact" in the header.
   screen()        A responsive screenshot from src/assets/img/screens/ (built by
                   `npm run screens` from scripts/screens.json).
   doodle()        One of the hand-placed line drawings. Lucide (ISC) plus the
                   whisk and spoon drawn for the screenshot set; always aria-hidden.
   mark()          A platform mark (Simple Icons, CC0; the marks stay the
                   trademarks of their owners). Monochrome, small, labelled.
   --------------------------------------------------------------------------- #}

{% macro wordmark(size, onRed) %}
<img class="wordmark__img{% if size %} wordmark__img--{{ size }}{% endif %}" src="/assets/img/wordmark-flavordraft{% if onRed %}-mono{% endif %}.png" alt="FlavorDraft" width="1193" height="274" decoding="async">
{%- endmacro %}

{% macro appStoreCta(site, variant) %}
<a class="appstore{% if variant %} appstore--{{ variant }}{% endif %}" href="{{ site.appStoreUrl }}"><img class="appstore__badge" src="/assets/img/app-store-badge{% if variant == 'on-red' %}-white{% endif %}.svg" alt="Download on the App Store" width="120" height="40" decoding="async"></a>
{%- endmacro %}

{% macro screen(name, alt, sizes, widths, w, h, eager) %}
{%- set ws = widths or [400, 800, 1200] -%}
<img src="/assets/img/screens/{{ name }}-{{ ws[1] }}.webp" srcset="{% for width in ws %}/assets/img/screens/{{ name }}-{{ width }}.webp {{ width }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes or '(min-width: 62em) 24rem, 72vw' }}" width="{{ w or 1320 }}" height="{{ h or 2868 }}" alt="{{ alt }}"{% if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{% macro phone(name, alt, sizes, class, eager, step) %}
<div class="phone{% if class %} {{ class }}{% endif %}"{% if step %} data-step="{{ step }}"{% endif %}><div class="phone__body"><div class="phone__screen">{{ screen(name, alt, sizes, null, null, null, eager) }}</div></div></div>
{%- endmacro %}

